# Copy to data/config.env. Replace placeholders before starting the bot.
# Optional settings stay commented to use the defaults from src/korone/config.py.
# Leave unset optional values commented; an empty value is not always valid.

# Telegram bot token from @BotFather (required).
TOKEN="123456789:REPLACE_WITH_YOUR_BOT_TOKEN"

# Telegram user IDs, not usernames or internal database IDs.
# The owner is automatically included in OPERATORS when configured.
# OWNER_ID=123456789
OPERATORS=[]
# DEBUG_MODE=false

# PostgreSQL and Redis for a bot running directly on the host.
# Create the database/user first and replace the example credentials as needed.
# Docker Compose overrides DB_URL, REDIS_HOST and REDIS_PORT with its services.
DB_URL="postgresql+asyncpg://korone:korone@localhost:5432/korone"
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_DB_STATES=2
# REDIS_DB_SCHEDULE=3

# Module selection uses JSON arrays. ["*"] loads all available modules.
MODULES_LOAD=["*"]
MODULES_NOT_LOAD=[]
# Example: MODULES_NOT_LOAD=["lastfm"]

# Locale and languages maintained directly by developers (JSON array).
# DEFAULT_LOCALE="en_US"
# DEVS_MANAGED_LANGUAGES=["en_US"]

# Optional integrations. Uncomment only when configured.
# LASTFM_KEY="replace_with_your_lastfm_api_key"
# SENTRY_URL="https://public_key@sentry.example.com/1"
# CORS_BYPASS_URL="http://localhost:8082"

# Media concurrency limits (1-32) and local transfer timeouts (positive seconds).
# MEDIA_MAX_CONCURRENT_DOWNLOADS=8
# MEDIA_MAX_CONCURRENT_TRANSFORMS=4
# MEDIA_MAX_CONCURRENT_POSTS=2
# MEDIA_LOCAL_DOWNLOAD_TIMEOUT_SECONDS=1800
# MEDIA_LOCAL_SEND_TIMEOUT_SECONDS=1800

# Local Bot API server (optional). Omit to use Telegram's public Bot API.
# Compose sets BOTAPI_SERVER and BOTAPI_UPLOAD_ROOT and mounts the shared volumes.
# Storage roots must be absolute; uploads must be inside the local storage root.
# BOTAPI_SERVER="http://localhost:8081"
# BOTAPI_LOCAL_STORAGE_ROOT="/var/lib/telegram-bot-api"
# BOTAPI_SERVER_STORAGE_ROOT="/var/lib/telegram-bot-api"
# BOTAPI_UPLOAD_ROOT="/var/lib/telegram-bot-api/korone-uploads"

# Webhooks (optional). Leave WEBHOOK_DOMAIN commented to use long polling.
# Set the public HTTPS origin and route it to the bot's web server.
# For Compose's tunnel profile, route to http://korone-bot:9669.
# Use a random secret containing only A-Z, a-z, 0-9, _ and - (1-256 characters).
# WEBHOOK_DOMAIN="https://bot.example.com"
# WEBHOOK_SECRET="replace_with_a_random_webhook_secret"
# WEBHOOK_PATH="/telegram/webhook"
# WEBHOOK_MAX_CONNECTIONS=40
# WEB_SERVER_PORT=8080
# Compose overrides WEB_SERVER_PORT to 9669.

# Project links shown in bot messages. Defaults point to PyKorone.
# TRANSLATION_URL="https://weblate.amanoteam.com/projects/korone/"
# NEWS_CHANNEL="https://t.me/PyKorone"
# SOURCE_CODE="https://github.com/HitaloM/PyKorone"
# PRIVACY_LINK="https://telegram.org/privacy-tpa"
# GITHUB_ISSUES="https://github.com/HitaloM/PyKorone/issues"
