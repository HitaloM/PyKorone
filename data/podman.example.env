# Copy to data/podman.env. Used by telegram-bot-api and the optional tunnel.
# Bot settings belong in data/config.env, based on data/config.example.env.

# Required by the local Telegram Bot API server.
# Obtain application credentials at https://my.telegram.org/apps.
# These are your application's API ID/hash, not the bot token from @BotFather.
# Image documentation: https://github.com/aiogram/telegram-bot-api#configuration
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH="replace_with_your_telegram_api_hash"

# Quadlet enables TELEGRAM_LOCAL and uses the default API port (8081).
# Keep that port aligned with BOTAPI_SERVER in deploy/quadlet/korone-bot.container.

# Optional Cloudflare Tunnel; used only when korone-tunnel.service is started.
# TUNNEL_TOKEN="replace_with_your_cloudflare_tunnel_token"
# Route your public hostname to http://korone-bot:9669 in Cloudflare.
# Set WEBHOOK_DOMAIN and WEBHOOK_SECRET in data/config.env as well.
